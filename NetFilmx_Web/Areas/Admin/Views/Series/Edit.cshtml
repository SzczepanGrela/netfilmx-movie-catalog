@model NetFilmx_Service.Dtos.Series.SeriesEditDto

<div style="max-width: 800px; margin: 0 auto;">
    <div class="container mt-5">
        <div class="admin-card">
            <div class="admin-card-header" style="display: flex; justify-content: space-between; align-items: center;">
                <div class="d-flex align-items-center">
                    <button onclick="history.back()" class="nfx-btn nfx-btn-secondary mr-3">Powrót</button>
                    <h1 class="mb-0">Edytuj serię</h1>
                </div>
                <button type="submit" form="editForm" class="nfx-btn nfx-btn-primary">Zapisz</button>
            </div>
            <div class="card-body">
                <form method="post" id="editForm">
                    <div class="form-group">
                        <label asp-for="Id" class="admin-label"></label>
                        <input asp-for="Id" class="admin-input" readonly />
                    </div>
                    <div class="form-group">
                        <label asp-for="Name" class="admin-label"></label>
                        <input asp-for="Name" class="admin-input" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Description" class="admin-label"></label>
                        <textarea asp-for="Description" class="admin-input"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Price" class="admin-label"></label>
                        <input asp-for="Price" class="admin-input" type="number" step="0.01" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
