@model IEnumerable<NetFilmx_Service.Dtos.User.UserListDto>

<div style="max-width: 800px; margin: 0 auto;">
    <div class="container mt-5">
        <h1 class="mb-4">Add Users to Series: @ViewBag.SeriesName</h1>

        @if (!Model.Any())
        {
            <p>No Users Outside of @ViewBag.SeriesName Found</p>
        }
        else
        {
            <form asp-action="AddUsers" method="post">
                <input type="hidden" name="seriesId" value="@ViewBag.SeriesId" />
                <div class="list-group">
                    @foreach (var user in Model)
                    {
                        <label class="list-group-item admin-label">
                            <input type="checkbox" name="userIds" value="@user.Id" />
                            @user.Username
                        </label>
                    }
                </div>
                <button type="submit" class="nfx-btn nfx-btn-primary mt-3" data-i18n="t_add_selected_users">Add Selected Users</button>
            </form>
        }
    </div>
</div>
