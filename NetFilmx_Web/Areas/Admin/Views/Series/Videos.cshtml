@model IEnumerable<NetFilmx_Service.Dtos.Video.VideoListDto>

<div style="max-width: 800px; margin: 0 auto;">
    <div class="admin-card">
        <div class="admin-card-header">
            <h1 class="mb-0">Filmy w serii: @ViewBag.SeriesName</h1>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <form asp-action="AddVideos" method="get" class="d-inline">
                    <input type="hidden" name="seriesId" value="@ViewBag.SeriesId" />
                    <input type="hidden" name="seriesName" value="@ViewBag.SeriesName" />
                    <button type="submit" class="nfx-btn nfx-btn-primary mb-2">Dodaj filmy</button>
                </form>

                <form asp-action="RemoveVideos" method="get" class="d-inline">
                    <input type="hidden" name="seriesId" value="@ViewBag.SeriesId" />
                    <input type="hidden" name="seriesName" value="@ViewBag.SeriesName" />
                    <button type="submit" class="nfx-btn nfx-btn-secondary mb-2" style="background: rgba(220, 53, 69, 0.2); color: #ff6b6b; border-color: rgba(220, 53, 69, 0.3);">Usuń filmy</button>
                </form>
            </div>

            @if (!Model.Any())
            {
                <p>Nie znaleziono filmów w serii @ViewBag.SeriesName</p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var video in Model)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <a href="@Url.Action("Details", "Video", new { videoId = video.Id })">@video.Title</a>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
