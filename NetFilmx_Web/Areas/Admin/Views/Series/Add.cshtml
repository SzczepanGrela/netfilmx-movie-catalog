@model NetFilmx_Service.Dtos.Series.SeriesAddDto

<div style="max-width: 800px; margin: 0 auto;">
    <div class="container mt-5">
        <div class="admin-card">
            <div class="admin-card-header">
                <h1>Add Series</h1>
            </div>
            <div class="card-body">
                <form asp-action="Add" method="post">
                    <div class="form-group">
                        <label asp-for="Name" class="admin-label"></label>
                        <input asp-for="Name" class="admin-input" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Description" class="admin-label"></label>
                        <textarea asp-for="Description" class="admin-input"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Price" class="admin-label"></label>
                        <input asp-for="Price" class="admin-input" type="number" step="0.01" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <button type="submit" class="nfx-btn nfx-btn-primary" data-i18n="t_add_series">Add Series</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
