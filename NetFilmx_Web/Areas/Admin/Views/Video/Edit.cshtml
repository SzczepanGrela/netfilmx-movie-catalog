@model NetFilmx_Service.Dtos.Video.VideoEditDto

@{
    ViewData["Title"] = "Edytuj Wideo";
}

<div class="admin-card" style="max-width: 800px; margin: 0 auto;">
    <div class="admin-card-header">
        <h4 style="margin: 0;">Edycja Wideo</h4>
        <button onclick="history.back()" class="nfx-btn nfx-btn-secondary"><i class="fas fa-arrow-left"></i> Wróć</button>
    </div>
    
    <div style="padding: 2rem;">
        <form method="post" id="editForm">
            <input type="hidden" asp-for="Id" />
            
            <div class="form-group" style="margin-bottom: 1.5rem;">
                <label asp-for="Title" class="admin-label"></label>
                <input asp-for="Title" class="admin-input" />
                <span asp-validation-for="Title" class="text-danger" style="color: #ff6b6b; font-size: 0.85rem; margin-top: 0.25rem; display: block;"></span>
            </div>
            
            <div class="form-group" style="margin-bottom: 1.5rem;">
                <label asp-for="Description" class="admin-label"></label>
                <textarea asp-for="Description" class="admin-input" rows="5"></textarea>
                <span asp-validation-for="Description" class="text-danger" style="color: #ff6b6b; font-size: 0.85rem; margin-top: 0.25rem; display: block;"></span>
            </div>
            
            <div class="form-group" style="margin-bottom: 1.5rem;">
                <label asp-for="Price" class="admin-label"></label>
                <input asp-for="Price" class="admin-input" type="number" step="0.01" />
                <span asp-validation-for="Price" class="text-danger" style="color: #ff6b6b; font-size: 0.85rem; margin-top: 0.25rem; display: block;"></span>
            </div>
            
            <div class="form-group" style="margin-bottom: 1.5rem;">
                <label asp-for="VideoUrl" class="admin-label"></label>
                <input asp-for="VideoUrl" class="admin-input" />
                <span asp-validation-for="VideoUrl" class="text-danger" style="color: #ff6b6b; font-size: 0.85rem; margin-top: 0.25rem; display: block;"></span>
            </div>
            
            <div class="form-group" style="margin-bottom: 2rem;">
                <label asp-for="ThumbnailUrl" class="admin-label"></label>
                <input asp-for="ThumbnailUrl" class="admin-input" />
                <span asp-validation-for="ThumbnailUrl" class="text-danger" style="color: #ff6b6b; font-size: 0.85rem; margin-top: 0.25rem; display: block;"></span>
            </div>
            
            <div style="display: flex; justify-content: flex-end; gap: 1rem; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 1.5rem;">
                <button type="submit" class="nfx-btn nfx-btn-primary"><i class="fas fa-save"></i> Zapisz zmiany</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
