@model NetFilmx_Web.Areas.Admin.Controllers.VideoController.UploadVideoViewModel

@{
    ViewData["Title"] = "Dodaj nowe Wideo";
}

<div class="row">
    <div class="col-md-12">
        <div class="admin-card">
            <div class="admin-card-header">
                <h3><i class="fas fa-video"></i> Dodaj nowe wideo HLS</h3>
            </div>
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    <div class="form-group">
                        <label asp-for="Title" class="admin-label"></label>
                        <input asp-for="Title" class="admin-input" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Price" class="admin-label"></label>
                        <input asp-for="Price" class="admin-input" type="number" step="0.01" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description" class="admin-label"></label>
                        <textarea asp-for="Description" class="admin-input"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="VideoUrl" class="admin-label">Wklej link z YouTube LUB</label>
                        <input asp-for="VideoUrl" class="admin-input" />
                        <span asp-validation-for="VideoUrl" class="text-danger"></span>
                    </div>

                    <div class="form-group border border-secondary p-3 rounded" style="background: rgba(0,0,0,0.2);">
                        <label asp-for="VideoFile" class="admin-label">Wgraj plik wideo (.mp4) z komputera (HLS)</label>
                        <input type="file" asp-for="VideoFile" class="admin-input" accept="video/mp4" style="background:transparent; border:none; padding-left:0;" />
                        <span asp-validation-for="VideoFile" class="text-danger"></span>
                        <small class="form-text" style="color:var(--color-text-muted);">Wybranie pliku spowoduje przetworzenie go w tle przez FFmpeg na format HLS.</small>
                    </div>
                    <div class="form-group border border-secondary p-3 rounded" style="background: rgba(0,0,0,0.2);">
                        <label asp-for="ThumbnailFile" class="admin-label">Wgraj plakat wideo (.jpg, .png)</label>
                        <input type="file" asp-for="ThumbnailFile" class="admin-input" accept="image/*" style="background:transparent; border:none; padding-left:0;" />
                        <span asp-validation-for="ThumbnailFile" class="text-danger"></span>
                    </div>

                    <button type="submit" class="nfx-btn nfx-btn-primary">Dodaj Wideo</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
