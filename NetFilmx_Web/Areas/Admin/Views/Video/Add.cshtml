@model NetFilmx_Web.Areas.Admin.Controllers.VideoController.UploadVideoViewModel

@{
    ViewData["Title"] = "Dodaj nowe Wideo";
}

<div class="row">
    <div class="col-md-12">
        <div class="admin-panel-card">
            <div class="admin-panel-header">
                <h3><i class="fas fa-video"></i> Dodaj nowe wideo HLS</h3>
            </div>
            <div class="admin-panel-body">
                <form method="post" enctype="multipart/form-data">
                    <div class="form-group">
                        <label asp-for="Title"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Price"></label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description"></label>
                        <textarea asp-for="Description" class="form-control"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="VideoUrl">Wklej link z YouTube LUB</label>
                        <input asp-for="VideoUrl" class="form-control" />
                        <span asp-validation-for="VideoUrl" class="text-danger"></span>
                    </div>

                    <div class="form-group border border-secondary p-3 rounded" style="background: rgba(0,0,0,0.2);">
                        <label asp-for="VideoFile">Wgraj plik wideo (.mp4) z komputera (HLS)</label>
                        <input type="file" asp-for="VideoFile" class="form-control-file" accept="video/mp4" />
                        <span asp-validation-for="VideoFile" class="text-danger"></span>
                        <small class="form-text text-muted">Wybranie pliku spowoduje przetworzenie go w tle przez FFmpeg na format HLS.</small>
                    </div>
                    <div class="form-group border border-secondary p-3 rounded" style="background: rgba(0,0,0,0.2);">
                        <label asp-for="ThumbnailFile">Wgraj plakat wideo (.jpg, .png)</label>
                        <input type="file" asp-for="ThumbnailFile" class="form-control-file" accept="image/*" />
                        <span asp-validation-for="ThumbnailFile" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Add Video</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
