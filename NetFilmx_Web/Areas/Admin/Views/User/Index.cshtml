@model NetFilmx_Service.Result.PaginatedList<NetFilmx_Service.Dtos.User.UserListDto>

@{
    ViewData["Title"] = "Lista Użytkowników";
    string currentSearch = Context.Request.Query["search"].ToString();
}

<div class="admin-card">
    <div class="admin-card-header">
        <h4 style="margin: 0;">Zarządzanie Użytkownikami</h4>
    </div>

    <form method="get" class="search-bar" style="margin-bottom: 1.5rem;">
        <input type="text" name="search" value="@currentSearch" placeholder="Szukaj po nazwie użytkownika lub emailu..." />
        <button type="submit" class="nfx-btn nfx-btn-secondary"><i class="fas fa-search"></i> Szukaj</button>
        @if (!string.IsNullOrEmpty(currentSearch))
        {
            <a href="/Admin/User" class="nfx-btn nfx-btn-secondary" data-i18n="t_wyczysc">Wyczyść</a>
        }
    </form>

    @if (Model == null || !Model.Items.Any())
    {
        <div style="text-align: center; padding: 3rem; color: var(--color-text-secondary);">
            <i class="fas fa-users" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5;"></i>
            <p>Brak użytkowników do wyświetlenia.</p>
        </div>
    }
    else
    {
        <div style="overflow-x: auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Nazwa Użytkownika</th>
                        <th>Email</th>
                        <th style="text-align: right;">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Items)
                    {
                        <tr>
                            <td style="font-weight: 500;">@user.Username</td>
                            <td>@user.Email</td>
                            <td style="text-align: right; display: flex; gap: 0.5rem; justify-content: flex-end;">
                                <a asp-action="Details" asp-route-userId="@user.Id" class="nfx-btn nfx-btn-secondary" style="padding: 0.4rem 0.8rem; font-size: 0.85rem;"><i class="fas fa-eye"></i></a>
                                <a asp-action="Edit" asp-route-userId="@user.Id" class="nfx-btn nfx-btn-primary" style="padding: 0.4rem 0.8rem; font-size: 0.85rem;"><i class="fas fa-edit"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <ul class="pagination">
                <li class="@(!Model.HasPreviousPage ? "disabled" : "")">
                    @if (Model.HasPreviousPage)
                    {
                        <a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)" asp-route-search="@currentSearch" data-i18n="t_poprzednia">Poprzednia</a>
                    }
                    else
                    {
                        <span data-i18n="t_poprzednia">Poprzednia</span>
                    }
                </li>
                
                <li class="active">
                    <span>@Model.PageIndex z @Model.TotalPages</span>
                </li>

                <li class="@(!Model.HasNextPage ? "disabled" : "")">
                    @if (Model.HasNextPage)
                    {
                        <a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)" asp-route-search="@currentSearch" data-i18n="t_nastepna">Następna</a>
                    }
                    else
                    {
                        <span data-i18n="t_nastepna">Następna</span>
                    }
                </li>
            </ul>
        }
    }
</div>
