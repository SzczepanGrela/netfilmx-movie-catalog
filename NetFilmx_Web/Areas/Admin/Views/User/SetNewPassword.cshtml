@model NetFilmx_Service.Dtos.User.UserPasswordDto

<div style="max-width: 800px; margin: 0 auto;">
    <div class="admin-card">
        <div class="admin-card-header d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <button onclick="history.back()" class="nfx-btn nfx-btn-secondary mr-3">Powrót</button>
                    <h1 class="mb-0">Ustaw nowe hasło</h1>
                </div>
                <button type="submit" form="passwordForm" class="nfx-btn nfx-btn-primary" data-i18n="t_zapisz">Zapisz</button>
            </div>
            <div class="card-body">
                <form method="post" id="passwordForm">
                    <div class="form-group">
                        <label asp-for="Id" class="admin-label"></label>
                        <input asp-for="Id" class="admin-input" readonly />
                    </div>
                    <div>
                        <label>@ViewBag.UserUsername</label>
                    </div>
                    <div class="form-group">
                        <label asp-for="Password" class="admin-label"></label>
                        <input asp-for="Password" class="admin-input" id="Password" onblur="validatePassword()" />
                        <span asp-validation-for="Password" class="text-danger" id="password-error"></span>
                    </div>
                </form>
            </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/validatePassword.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // prevent sending form if validation fails
        $(document).ready(function () {
            $('#passwordForm').on('submit', function (e) {
                validatePassword();
                if (!isPasswordValid) {
                    e.preventDefault();
                    alert('Popraw błędy w formularzu przed wysłaniem.');
                }
            });
        });
    </script>
}
