@model NetFilmx_Service.Dtos.User.UserEditDto

<div style="max-width: 800px; margin: 0 auto;">
    <div class="container mt-5">
        <div class="admin-card">
            <div class="admin-card-header" style="display: flex; justify-content: space-between; align-items: center;">
                <div class="d-flex align-items-center">
                    <button onclick="history.back()" class="nfx-btn nfx-btn-secondary mr-3">Powrót</button>
                    <h1 class="mb-0">Edytuj użytkownika</h1>
                </div>
                <button type="submit" form="editForm" class="nfx-btn nfx-btn-primary">Zapisz</button>
            </div>
            <div class="card-body">
                <form method="post" id="editForm">
                    <div class="form-group">
                        <label asp-for="Id" class="admin-label"></label>
                        <input asp-for="Id" class="admin-input" readonly />
                    </div>
                    <div class="form-group">
                        <label asp-for="Username" class="admin-label"></label>
                        <input asp-for="Username" class="admin-input" id="Username" onblur="validateUsername('@Model.Id')" />
                        <span asp-validation-for="Username" class="text-danger" id="username-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Email" class="admin-label"></label>
                        <input asp-for="Email" class="admin-input" id="Email" onblur="validateEmail()" />
                        <span asp-validation-for="Email" class="text-danger" id="email-error"></span>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/validateUsername.js"></script>
    <script src="~/js/validateEmail.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // prevent sending form if validation fails
        $(document).ready(function () {
            $('#editForm').on('submit', function (e) {
                validateUsername('@Model.Id');
                validateEmail();
                if (!isUsernameValid || !isEmailValid) {
                    e.preventDefault();
                    alert('Popraw błędy w formularzu przed wysłaniem.');
                }
            });
        });
    </script>
}
