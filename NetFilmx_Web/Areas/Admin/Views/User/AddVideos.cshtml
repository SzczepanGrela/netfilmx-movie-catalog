@model IEnumerable<NetFilmx_Service.Dtos.Video.VideoListDto>

<div style="max-width: 800px; margin: 0 auto;">
    <div class="admin-card">
        <div class="admin-card-header">
            <h1 class="mb-0">Dodaj filmy użytkownikowi: @ViewBag.UserUsername</h1>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <p>Brak filmów do dodania</p>
            }
            else
            {
                <form asp-action="AddVideos" method="post">
                    <input type="hidden" name="userId" value="@ViewBag.UserId" />
                    <input type="hidden" name="userUsername" value="@ViewBag.UserUsername" />
                    <div class="list-group">
                        @foreach (var video in Model)
                        {
                            <label class="list-group-item admin-label">
                                <input type="checkbox" name="videoIds" value="@video.Id" /> @video.Title
                            </label>
                        }
                    </div>
                    <button type="submit" class="nfx-btn nfx-btn-primary mt-3" data-i18n="t_dodaj_wybrane_filmy">Dodaj wybrane filmy</button>
                </form>
            }
        </div>
    </div>
</div>
