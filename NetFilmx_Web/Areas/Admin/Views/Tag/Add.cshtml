@model NetFilmx_Service.Dtos.Tag.TagAddDto

<div style="max-width: 800px; margin: 0 auto;">
    <div class="admin-card">
        <div class="admin-card-header">
            <h1>Dodaj nowy tag</h1>
        </div>
        <div class="card-body">
            <form method="post" asp-action="Add">
                <div class="form-group">
                    <label asp-for="Name" class="admin-label"></label>
                    <input asp-for="Name" class="admin-input" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>                

                <button type="submit" class="nfx-btn nfx-btn-primary">Dodaj Tag</button>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
