@model IEnumerable<NetFilmx_Service.Dtos.Video.VideoListDto>

<div style="max-width: 800px; margin: 0 auto;">
    <h1 class="mb-4">Videos in Tag: @ViewBag.TagName</h1>

    <div class="mb-3">
        <form asp-action="AddVideos" method="get" class="d-inline">
            <input type="hidden" name="tagId" value="@ViewBag.TagId" />
            <input type="hidden" name="tagName" value="@ViewBag.TagName" />
            <button type="submit" class="nfx-btn nfx-btn-primary btn-sm mb-2">Add Videos</button>
        </form>

        <form asp-action="RemoveVideos" method="get" class="d-inline">
            <input type="hidden" name="tagId" value="@ViewBag.TagId" />
            <input type="hidden" name="tagName" value="@ViewBag.TagName" />
            <button type="submit" class="nfx-btn nfx-btn-secondary btn-sm mb-2" style="background: rgba(220, 53, 69, 0.2); color: #ff6b6b; border-color: rgba(220, 53, 69, 0.3);">Remove Videos</button>
        </form>
    </div>

    @if (!Model.Any())
    {
        <p>No Videos Found in Tag: @ViewBag.TagName</p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var video in Model)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <a href="@Url.Action("Details", "Video", new { videoId = video.Id })">@video.Title</a>
                </li>
            }
        </ul>
    }
</div>
