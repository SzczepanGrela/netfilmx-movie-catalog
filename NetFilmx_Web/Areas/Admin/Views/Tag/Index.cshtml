@model NetFilmx_Service.Result.PaginatedList<NetFilmx_Service.Dtos.Tag.TagListDto>

@{
    ViewData["Title"] = "Tagi";
}

<div class="admin-card">
    <div class="admin-card-header">
        <h4 style="margin: 0;">Zarządzanie Tagami</h4>
        
        <div style="display: flex; gap: 1rem; align-items: center;">
            <div class="search-bar">
                <form method="get" asp-action="Index" style="display: flex; gap: 0.5rem; margin: 0;">
                    <input type="text" name="search" placeholder="Szukaj taga..." value="@ViewBag.SearchTerm" />
                    <button type="submit" class="nfx-btn nfx-btn-secondary" style="padding: 0.5rem 1rem;"><i class="fas fa-search"></i></button>
                </form>
            </div>
            <a asp-action="Add" class="nfx-btn nfx-btn-primary"><i class="fas fa-plus"></i> Dodaj tag</a>
        </div>
    </div>

    @if (Model == null || !Model.Items.Any())
    {
        <div style="text-align: center; padding: 3rem; color: var(--color-text-secondary);">
            <i class="fas fa-tags" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5;"></i>
            <p>Brak tagów do wyświetlenia.</p>
        </div>
    }
    else
    {
        <div style="overflow-x: auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Nazwa Taga</th>
                        <th style="text-align: right;">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tag in Model.Items)
                    {
                        <tr>
                            <td style="font-weight: 500;">
                                <span style="background: rgba(123, 44, 191, 0.2); color: var(--color-accent); padding: 0.2rem 0.6rem; border-radius: 12px; font-size: 0.85rem;">
                                    <i class="fas fa-hashtag" style="opacity: 0.5; margin-right: 2px;"></i>@tag.Name
                                </span>
                            </td>
                            <td style="text-align: right; display: flex; gap: 0.5rem; justify-content: flex-end;">
                                <a asp-action="Edit" asp-route-tagId="@tag.Id" class="nfx-btn nfx-btn-primary" style="padding: 0.4rem 0.8rem; font-size: 0.85rem;"><i class="fas fa-edit"></i> Edytuj</a>
                                <form asp-action="Delete" method="post" style="margin: 0;" onsubmit="return confirm('Na pewno chcesz usunąć ten tag?');">
                                    <input type="hidden" name="tagId" value="@tag.Id" />
                                    <button type="submit" class="nfx-btn nfx-btn-secondary" style="padding: 0.4rem 0.8rem; font-size: 0.85rem; background: rgba(220, 53, 69, 0.2); color: #ff6b6b; border-color: rgba(220, 53, 69, 0.3);"><i class="fas fa-trash"></i> Usuń</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <ul class="pagination">
                <li class="@(Model.HasPreviousPage ? "" : "disabled")">
                    <a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)" asp-route-search="@ViewBag.SearchTerm" data-i18n="t_poprzednia">Poprzednia</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="@(i == Model.PageIndex ? "active" : "")">
                        <a asp-action="Index" asp-route-pageNumber="@i" asp-route-search="@ViewBag.SearchTerm">@i</a>
                    </li>
                }
                <li class="@(Model.HasNextPage ? "" : "disabled")">
                    <a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)" asp-route-search="@ViewBag.SearchTerm" data-i18n="t_nastepna">Następna</a>
                </li>
            </ul>
        }
    }
</div>
