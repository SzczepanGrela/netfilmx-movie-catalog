@model IEnumerable<NetFilmx_Service.Dtos.Video.VideoListDto>

<div style="max-width: 800px; margin: 0 auto;">
    <h1 class="mb-4">Remove Videos from Tag: @ViewBag.TagName</h1>

    @if (!Model.Any())
    {
        <p>No Videos Found in Tag: @ViewBag.TagName</p>
    }
    else
    {
        <form asp-action="RemoveVideos" method="post">
            <input type="hidden" name="tagId" value="@ViewBag.TagId" />
            <div class="list-group">
                @foreach (var video in Model)
                {
                    <label class="list-group-item admin-label">
                        <input type="checkbox" name="videoIds" value="@video.Id" />
                        @video.Title
                    </label>
                }
            </div>
            <button type="submit" class="nfx-btn nfx-btn-secondary mt-3" style="background: rgba(220, 53, 69, 0.2); color: #ff6b6b; border-color: rgba(220, 53, 69, 0.3);" data-i18n="t_remove_selected_videos">Remove Selected Videos</button>
        </form>
    }
</div>
