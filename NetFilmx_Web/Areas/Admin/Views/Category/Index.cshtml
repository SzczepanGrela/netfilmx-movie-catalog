@model NetFilmx_Service.Result.PaginatedList<NetFilmx_Service.Dtos.Category.CategoryListDto>

@{
    ViewData["Title"] = "Kategorie";
}

<div class="admin-card">
    <div class="admin-card-header">
        <h4 style="margin: 0;">Zarządzanie Kategoriami</h4>
        
        <div style="display: flex; gap: 1rem; align-items: center;">
            <div class="search-bar">
                <form method="get" asp-action="Index" style="display: flex; gap: 0.5rem; margin: 0;">
                    <input type="text" name="search" placeholder="Szukaj kategorii..." value="@ViewBag.SearchTerm" />
                    <button type="submit" class="nfx-btn nfx-btn-secondary" style="padding: 0.5rem 1rem;"><i class="fas fa-search"></i></button>
                </form>
            </div>
            <a asp-action="Add" class="nfx-btn nfx-btn-primary"><i class="fas fa-plus"></i> Dodaj kategorię</a>
        </div>
    </div>

    @if (Model == null || !Model.Items.Any())
    {
        <div style="text-align: center; padding: 3rem; color: var(--color-text-secondary);">
            <i class="fas fa-list" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5;"></i>
            <p>Brak kategorii do wyświetlenia.</p>
        </div>
    }
    else
    {
        <div style="overflow-x: auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Nazwa Kategorii</th>
                        <th style="text-align: right;">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model.Items)
                    {
                        <tr>
                            <td style="font-weight: 500;">@category.Name</td>
                            <td style="text-align: right; display: flex; gap: 0.5rem; justify-content: flex-end;">
                                <a asp-action="Edit" asp-route-categoryId="@category.Id" class="nfx-btn nfx-btn-primary" style="padding: 0.4rem 0.8rem; font-size: 0.85rem;"><i class="fas fa-edit"></i> Edytuj</a>
                                <form asp-action="Delete" method="post" style="margin: 0;" onsubmit="return confirm('Na pewno chcesz usunąć tę kategorię?');">
                                    <input type="hidden" name="categoryId" value="@category.Id" />
                                    <button type="submit" class="nfx-btn nfx-btn-secondary" style="padding: 0.4rem 0.8rem; font-size: 0.85rem; background: rgba(220, 53, 69, 0.2); color: #ff6b6b; border-color: rgba(220, 53, 69, 0.3);"><i class="fas fa-trash"></i> Usuń</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <ul class="pagination">
                <li class="@(Model.HasPreviousPage ? "" : "disabled")">
                    <a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)" asp-route-search="@ViewBag.SearchTerm">Poprzednia</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="@(i == Model.PageIndex ? "active" : "")">
                        <a asp-action="Index" asp-route-pageNumber="@i" asp-route-search="@ViewBag.SearchTerm">@i</a>
                    </li>
                }
                <li class="@(Model.HasNextPage ? "" : "disabled")">
                    <a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)" asp-route-search="@ViewBag.SearchTerm">Następna</a>
                </li>
            </ul>
        }
    }
</div>
