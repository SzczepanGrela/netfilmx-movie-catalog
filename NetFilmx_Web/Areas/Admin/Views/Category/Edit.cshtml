@model NetFilmx_Service.Dtos.Category.CategoryEditDto

<div style="max-width: 800px; margin: 0 auto;">
    <div class="admin-card">
        <div class="admin-card-header d-flex justify-content-between align-items-center" style="display: flex; justify-content: space-between; align-items: center;">
            <div class="d-flex align-items-center">
                <button onclick="history.back()" class="nfx-btn nfx-btn-secondary mr-3">Powrót</button>
                <h1 class="mb-0">Edytuj kategorię</h1>
            </div>
            <button type="submit" form="editForm" class="nfx-btn nfx-btn-primary" data-i18n="t_zapisz">Zapisz</button>
        </div>
        <div class="card-body">
            <form method="post" id="editForm" asp-action="Edit">
                <div class="form-group">
                    <label asp-for="Id" class="admin-label"></label>
                    <input asp-for="Id" class="admin-input" readonly />
                </div>
                <div class="form-group">
                    <label asp-for="Name" class="admin-label"></label>
                    <input asp-for="Name" class="admin-input" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Description" class="admin-label"></label>
                    <textarea asp-for="Description" class="admin-input"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
