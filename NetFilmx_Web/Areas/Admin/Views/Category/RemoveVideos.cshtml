@model IEnumerable<NetFilmx_Service.Dtos.Video.VideoListDto>

<div style="max-width: 800px; margin: 0 auto;">
    <h1 class="mb-4">Remove Videos from Category: @ViewBag.CategoryName</h1>

    @if (!Model.Any())
    {
        <p>No Videos Found in Category: @ViewBag.CategoryName</p>
    }
    else
    {
        <form asp-action="RemoveVideos" method="post">
            <input type="hidden" name="categoryId" value="@ViewBag.CategoryId" />
            <div class="list-group">
                @foreach (var video in Model)
                {
                    <label class="list-group-item admin-label">
                        <input type="checkbox" name="videoIds" value="@video.Id" />
                        @video.Title
                    </label>
                }
            </div>
            <button type="submit" class="nfx-btn nfx-btn-secondary mt-3" style="background: rgba(220, 53, 69, 0.2); color: #ff6b6b; border-color: rgba(220, 53, 69, 0.3);">Remove Selected Videos</button>
        </form>
    }
</div>
