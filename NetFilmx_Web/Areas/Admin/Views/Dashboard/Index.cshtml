@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">
    <div class="col-md-4">
        <div class="admin-stat-card">
            <div class="admin-stat-icon">
                <i class="fas fa-users"></i>
            </div>
            <div class="admin-stat-details">
                <h4>Użytkownicy</h4>
                <h2>@ViewBag.TotalUsers</h2>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="admin-stat-card">
            <div class="admin-stat-icon" style="color: #6366f1;">
                <i class="fas fa-video"></i>
            </div>
            <div class="admin-stat-details">
                <h4>Filmy & Wideo</h4>
                <h2>@ViewBag.TotalVideos</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="admin-stat-card">
            <div class="admin-stat-icon" style="color: #10b981;">
                <i class="fas fa-shopping-cart"></i>
            </div>
            <div class="admin-stat-details">
                <h4>Transakcje</h4>
                <h2>@ViewBag.TotalPurchases</h2>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="admin-panel-card">
            <div class="admin-panel-header">
                <h3>Szybkie akcje</h3>
            </div>
            <div class="admin-panel-body">
                <a href="/admin/video/add" class="btn btn-primary"><i class="fas fa-plus"></i> Dodaj nowe wideo</a>
                <a href="/admin/jobs" target="_blank" class="btn btn-outline-secondary ml-2"><i class="fas fa-server"></i> Status Serwera (Hangfire)</a>
            </div>
        </div>
    </div>
</div>
