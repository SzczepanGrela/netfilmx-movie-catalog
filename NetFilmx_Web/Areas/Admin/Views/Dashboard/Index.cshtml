@{
    ViewData["Title"] = "Dashboard";
}

<div class="admin-card-header" style="border: none;">
    <h2 style="margin: 0; font-weight: 700;">Przegląd Systemu</h2>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
    <div class="admin-card" style="margin-bottom: 0;">
        <h4 style="color: var(--color-text-secondary); font-size: 1rem; margin-top: 0;">Całkowita liczba wideo</h4>
        <div style="font-size: 2.5rem; font-weight: 700; color: var(--color-accent);">@ViewBag.TotalVideos</div>
    </div>
    
    <div class="admin-card" style="margin-bottom: 0;">
        <h4 style="color: var(--color-text-secondary); font-size: 1rem; margin-top: 0;">Liczba użytkowników</h4>
        <div style="font-size: 2.5rem; font-weight: 700; color: var(--neon-blue);">@ViewBag.TotalUsers</div>
    </div>
    
    <div class="admin-card" style="margin-bottom: 0;">
        <h4 style="color: var(--color-text-secondary); font-size: 1rem; margin-top: 0;">Suma zakupów</h4>
        <div style="font-size: 2.5rem; font-weight: 700; color: #28a745;">@ViewBag.TotalPurchases</div>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <h4>Szybkie Akcje</h4>
    </div>
    <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <a href="/Admin/Video/Add" class="nfx-btn nfx-btn-primary"><i class="fas fa-plus"></i> Dodaj nowe wideo</a>
        <a href="/Admin/Series/Add" class="nfx-btn nfx-btn-secondary"><i class="fas fa-folder-plus"></i> Dodaj nową serię</a>
        <a href="/Admin/Category/Add" class="nfx-btn nfx-btn-secondary"><i class="fas fa-list"></i> Nowa kategoria</a>
    </div>
</div>
