@model NetFilmx_Service.Dtos.Comment.CommentAddDto

<div style="max-width: 800px; margin: 0 auto;">
    <div class="container mt-5">
        <div class="admin-card">
            <div class="admin-card-header">
                <h1>Dodaj nowy komentarz</h1>
            </div>
            <div class="card-body">
                <form method="post">
                    <div class="form-group">
                        <label asp-for="UserId" class="admin-label"></label>
                        <select asp-for="UserId" class="admin-input" asp-items="ViewBag.Users"></select>
                        <span asp-validation-for="UserId" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="VideoId" class="admin-label"></label>
                        <select asp-for="VideoId" class="admin-input" asp-items="ViewBag.Videos"></select>
                        <span asp-validation-for="VideoId" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Content" class="admin-label"></label>
                        <textarea asp-for="Content" class="admin-input"></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>
                    <button type="submit" class="nfx-btn nfx-btn-primary">Dodaj Komentarz</button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
