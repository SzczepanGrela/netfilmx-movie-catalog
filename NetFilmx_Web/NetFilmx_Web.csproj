<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>73b473f7-c768-42ea-ba1b-d67cec4c4ca8</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="wwwroot\js\validateUsername.js" />
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="..\SQL\InsertNetFilmxDb_SQLite.sql" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\SQL\InsertNetFilmxDb_PostgreSQL.sql" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetFilmx_Service\NetFilmx_Service.csproj" />
    <ProjectReference Include="..\NetFilmx_Storage.PostgreSql\NetFilmx_Storage.PostgreSql.csproj" />
   </ItemGroup>

  <ItemGroup>

    <None Include="wwwroot\js\refresh.js" />
    <None Include="wwwroot\js\validateUsername.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.24" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.20.12" />
    <!-- Hangfire.Core permits Newtonsoft.Json 11; pin a patched serializer. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="MediatR" Version="12.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.31" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.31">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Formats.Asn1" Version="10.0.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ClassDiagram\" />
  </ItemGroup>

</Project>
