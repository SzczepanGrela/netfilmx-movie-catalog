@model NetFilmx_Web.Controllers.LoginRequest
@{
    ViewData["Title"] = "Zaloguj się - NetFilmx";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: calc(100vh - 150px);">
    <div class="col-md-6 col-lg-4">
        <div class="card p-4 shadow-lg border-0" style="background: rgba(30, 30, 40, 0.7); backdrop-filter: blur(20px); border-radius: 15px;">
            <div class="card-body">
                <div class="text-center mb-4">
                    <h2 class="fw-bold" style="background: linear-gradient(90deg, var(--neon-purple), var(--neon-blue)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                        Witaj ponownie!
                    </h2>
                    <p class="text-muted">Zaloguj się, aby kontynuować oglądanie.</p>
                </div>

                <form asp-action="Login" method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Username" class="form-control text-white" style="background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.1);" placeholder="Nazwa użytkownika" required />
                        <label asp-for="Username" class="text-muted">Nazwa użytkownika</label>
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Password" type="password" class="form-control text-white" style="background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.1);" placeholder="Hasło" required />
                        <label asp-for="Password" class="text-muted">Hasło</label>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input custom-checkbox" type="checkbox" id="rememberMe" />
                        <label class="form-check-label text-muted" for="rememberMe">
                            Zapamiętaj mnie
                        </label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold" style="background: linear-gradient(90deg, var(--neon-purple), var(--neon-blue)); border: none; box-shadow: 0 0 15px rgba(138, 43, 226, 0.5); transition: all 0.3s ease;">
                            Zaloguj się
                        </button>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <p class="text-muted mb-0">Nie masz konta? <a asp-action="Register" class="text-decoration-none fw-bold" style="color: var(--neon-blue);">Zarejestruj się</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .custom-checkbox:checked {
            background-color: var(--neon-purple);
            border-color: var(--neon-purple);
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 25px rgba(138, 43, 226, 0.8) !important;
        }
        .form-control:focus {
            background: rgba(0,0,0,0.7) !important;
            border-color: var(--neon-blue) !important;
            box-shadow: 0 0 0 0.25rem rgba(0, 212, 255, 0.25) !important;
            color: white !important;
        }
    </style>
}
