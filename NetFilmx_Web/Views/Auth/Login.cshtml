@model NetFilmx_Web.Controllers.LoginRequest
@{
    ViewData["Title"] = "Zaloguj się - NetFilmx";
}

<div class="nfx-hero" style="background-image: url('https://netfilmx-assets.grela.dev/backdrops/cyberpunk_backdrop.jpg'); justify-content: center; align-items: center; min-height: 100vh;">
    <div class="nfx-hero-overlay" style="background: linear-gradient(to top, var(--color-base) 0%, rgba(4, 8, 20, 0.8) 100%);"></div>
    
    <div style="position: relative; z-index: 10; width: 100%; max-width: 450px; background: rgba(10, 17, 40, 0.6); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); border: 1px solid rgba(123, 44, 191, 0.2); border-radius: var(--border-radius); padding: 3rem 2rem; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
        
        <div style="text-align: center; margin-bottom: 2rem;">
            <h2 style="font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem; background: linear-gradient(90deg, var(--color-accent), var(--color-accent-hover)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Witaj ponownie!</h2>
            <p style="color: var(--color-text-secondary); font-size: 0.95rem;">Zaloguj się, aby kontynuować oglądanie.</p>
        </div>

        <form asp-action="Login" method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
            <div asp-validation-summary="ModelOnly" style="color: #ff4d4f; font-size: 0.9rem; margin-bottom: 1rem;"></div>

            <div style="margin-bottom: 1.5rem;">
                <label asp-for="Username" style="display: block; font-size: 0.9rem; color: var(--color-text-secondary); margin-bottom: 0.5rem;">Nazwa użytkownika</label>
                <input asp-for="Username" style="width: 100%; padding: 0.8rem 1rem; background: rgba(0,0,0,0.4); border: 1px solid rgba(123, 44, 191, 0.3); border-radius: var(--border-radius); color: white; font-family: var(--font-family); outline: none; transition: border-color 0.3s;" required />
                <span asp-validation-for="Username" style="color: #ff4d4f; font-size: 0.8rem; margin-top: 0.3rem; display: block;"></span>
            </div>
            
            <div style="margin-bottom: 1.5rem;">
                <label asp-for="Password" style="display: block; font-size: 0.9rem; color: var(--color-text-secondary); margin-bottom: 0.5rem;">Hasło</label>
                <input asp-for="Password" type="password" style="width: 100%; padding: 0.8rem 1rem; background: rgba(0,0,0,0.4); border: 1px solid rgba(123, 44, 191, 0.3); border-radius: var(--border-radius); color: white; font-family: var(--font-family); outline: none; transition: border-color 0.3s;" required />
                <span asp-validation-for="Password" style="color: #ff4d4f; font-size: 0.8rem; margin-top: 0.3rem; display: block;"></span>
            </div>

            <div style="margin-bottom: 2.5rem; display: flex; align-items: center; gap: 0.5rem;">
                <input asp-for="RememberMe" type="checkbox" style="accent-color: var(--color-accent); width: 1.1rem; height: 1.1rem; cursor: pointer;" />
                <label asp-for="RememberMe" style="font-size: 0.9rem; color: var(--color-text-secondary); cursor: pointer;">Zapamiętaj mnie</label>
            </div>

            <button type="submit" class="nfx-btn nfx-btn-primary" style="width: 100%;" data-i18n="t_zaloguj_sie">Zaloguj się</button>
        </form>

        <div style="text-align: center; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.1);">
            <p style="color: var(--color-text-secondary); font-size: 0.95rem; margin: 0;">
                Nie masz konta? <a asp-action="Register" style="color: var(--color-accent-hover); font-weight: 600;">Zarejestruj się</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        input[type="text"]:focus, input[type="password"]:focus {
            border-color: var(--color-accent) !important;
            box-shadow: 0 0 0 2px rgba(123, 44, 191, 0.2);
        }
    </style>
}
