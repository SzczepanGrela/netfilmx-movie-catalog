@model NetFilmx_Service.Dtos.Video.VideoCardDto
@{
    ViewData["Title"] = Model.Title;
}

@section Scripts {
    <!-- Vidstack -->
    <link rel="stylesheet" href="https://cdn.vidstack.io/player/theme.css" />
    <link rel="stylesheet" href="https://cdn.vidstack.io/player/video.css" />
    <script type="module" src="https://cdn.vidstack.io/player"></script>
}

<div style="padding-top: 80px; min-height: 100vh; background: var(--color-base); position: relative;">
    
    <!-- Ambient Background (Blurred Poster) -->
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 60vh; background-image: url('@(Model.BackdropUrl ?? Model.ThumbnailUrl)'); background-size: cover; background-position: center; filter: blur(50px) brightness(0.3); z-index: 0; pointer-events: none;"></div>

    <div style="position: relative; z-index: 10; max-width: 1400px; margin: 0 auto; padding: 2rem 4%;">
        
        <!-- Odtwarzacz -->
        <div style="border-radius: var(--border-radius); overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.8); background: #000; aspect-ratio: 16/9; margin-bottom: 2rem;">
            <media-player src="@Model.VideoUrl" title="@Model.Title" autoplay>
                <media-provider></media-provider>
                <media-video-layout></media-video-layout>
            </media-player>
        </div>

        <!-- Meta informacje i Płatność -->
        <div style="display: flex; flex-wrap: wrap; gap: 2rem; align-items: flex-start; justify-content: space-between;">
            
            <div style="flex: 1; min-width: 300px;">
                <h1 style="font-size: 2.5rem; font-weight: 700; margin-bottom: 0.5rem;">@Model.Title</h1>
                <div class="nfx-hero-meta" style="margin-bottom: 1.5rem;">
                    @if (!string.IsNullOrEmpty(Model.AgeRating))
                    {
                        <span class="nfx-badge">@Model.AgeRating</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.QualityBadge))
                    {
                        <span class="nfx-badge">@Model.QualityBadge</span>
                    }
                    @if (Model.ReleaseYear.HasValue)
                    {
                        <span>@Model.ReleaseYear.Value</span>
                    }
                </div>
                <p style="color: var(--color-text-secondary); font-size: 1.1rem; line-height: 1.6;">
                    @Model.Description
                </p>
            </div>

            <!-- Panel Płatności (Mock) -->
            <div style="flex: 1 1 350px; width: 100%; max-width: 400px; background: rgba(10, 17, 40, 0.6); backdrop-filter: blur(12px); border: 1px solid rgba(123, 44, 191, 0.3); border-radius: var(--border-radius); padding: 1.5rem; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
                <h3 style="font-size: 1.2rem; font-weight: 600; margin-bottom: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.5rem;">Odblokuj pełny dostęp</h3>
                
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <p style="color: var(--color-text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
                        Twój portfel: <strong style="color: #fff;">150 Kredytów</strong>
                    </p>
                    <div style="background: rgba(0,0,0,0.3); border-radius: 8px; padding: 1rem; margin-bottom: 1.5rem; text-align: center;">
                        <span style="font-size: 2rem; font-weight: 700; color: var(--color-accent-hover);">20</span>
                        <span style="color: var(--color-text-secondary);"> Kredytów</span>
                    </div>
                    <button class="nfx-btn nfx-btn-primary" style="width: 100%;" onclick="alert('Mock: Dostęp odblokowany! Pobrane z portfela.')">
                        Kup dostęp
                    </button>
                }
                else
                {
                    <p style="color: var(--color-text-secondary); font-size: 0.95rem; margin-bottom: 1.5rem;">Zaloguj się, aby odblokować ten materiał przy użyciu swoich kredytów.</p>
                    <a href="/Auth/Login" class="nfx-btn nfx-btn-secondary" style="width: 100%;">Zaloguj się</a>
                }
            </div>

        </div>

    </div>
</div>
