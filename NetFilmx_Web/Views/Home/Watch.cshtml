@model NetFilmx_Web.ViewModels.WatchPageViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = Model.Video.Title;
    var filmCredit = NetFilmx_Web.Services.RetainedMediaCredits.Find(Model.Video, Configuration["CloudflareR2:PublicUrl"]);
    bool isProcessing = Model.Video.VideoUrl == "PROCESSING";
    bool isFailed = Model.Video.VideoUrl == "FAILED";
}

@section Scripts {
    <!-- Vidstack -->
    <link rel="stylesheet" href="~/lib/vidstack/styles/player/default/theme.css" />
    <link rel="stylesheet" href="~/lib/vidstack/styles/player/default/layouts/video.css" />
    <script src="~/js/video-player.js" asp-append-version="true"></script>
    <script type="module" src="~/lib/vidstack/player.js"></script>

}

<div style="padding-top: 80px; min-height: 100vh; background: var(--color-base); position: relative; padding-bottom: 4rem;">
    
    <!-- Ambient Background (Blurred Poster) -->
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 60vh; background-image: url('@(Model.Video.BackdropUrl ?? Model.Video.ThumbnailUrl ?? "")'); background-size: cover; background-position: center; filter: blur(50px) brightness(0.25); z-index: 0; pointer-events: none;"></div>

    <div style="position: relative; z-index: 10; max-width: 1400px; margin: 0 auto; padding: 2rem 4%;">
        
        <!-- Player or Processing State -->
        <div style="border-radius: var(--border-radius); overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.8); background: #000; aspect-ratio: 16/9; margin-bottom: 2rem; display: flex; align-items: center; justify-content: center; position: relative;">
            
            @if (isProcessing)
            {
                <div style="text-align: center; padding: 2rem;">
                    <div style="width: 50px; height: 50px; border: 4px solid rgba(123, 44, 191, 0.3); border-top-color: var(--color-accent); border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 1.5rem;"></div>
                    <h3 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.5rem;" data-i18n="t_przetwarzanie_wideo">Video is processing...</h3>
                    <p style="color: var(--color-text-secondary); max-width: 450px; margin: 0 auto 1.5rem;" data-i18n="t_przetwarzanie_wideo_opis">Generating adaptive HLS streams (1080p, 720p, 480p). Please refresh in a moment.</p>
                    <button onclick="window.location.reload()" class="nfx-btn nfx-btn-secondary" style="font-size: 0.9rem; padding: 0.5rem 1.2rem;" data-i18n="t_odswiez">
                        <i class="fas fa-sync-alt"></i> Refresh
                    </button>
                </div>
            }
            else if (isFailed)
            {
                <div style="text-align: center; padding: 2rem;">
                    <i class="fas fa-exclamation-triangle" style="font-size: 3rem; color: #dc3545; margin-bottom: 1rem; display: block;"></i>
                    <h3 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.5rem; color: #ff6b6b;" data-i18n="t_blad_przetwarzania">Video Processing Error</h3>
                    <p style="color: var(--color-text-secondary); max-width: 450px; margin: 0 auto;" data-i18n="t_blad_przetwarzania_opis">An error occurred during video processing. Please contact the administrator.</p>
                </div>
            }
            else
            {
                <partial name="_VideoPlayer" model="Model.Video" />


            }

        </div>

        <p id="subtitle-status" role="status" hidden data-i18n="t_subtitle_unavailable">A subtitle track could not be loaded. Try another language or retry playback.</p>

        <!-- Film information -->
        @if (filmCredit is not null) { <partial name="_MediaCredit" model="filmCredit" /> }
        <div style="display: flex; flex-wrap: wrap; gap: 2rem; align-items: flex-start; justify-content: space-between;">
            
            <div style="flex: 1; min-width: 300px;">
                <h1 style="font-size: 2.5rem; font-weight: 700; margin-bottom: 0.5rem;">@Model.Video.Title</h1>
                <div class="nfx-hero-meta" style="margin-bottom: 1.5rem;">
                    @if (!string.IsNullOrEmpty(Model.Video.AgeRating))
                    {
                        <span class="nfx-badge">@Model.Video.AgeRating</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Video.QualityBadge))
                    {
                        <span class="nfx-badge">@Model.Video.QualityBadge</span>
                    }
                    @if (Model.Video.ReleaseYear.HasValue)
                    {
                        <span>@Model.Video.ReleaseYear.Value</span>
                    }
                    @if (Model.Video.DurationMinutes.HasValue)
                    {
                        <span>• @Model.Video.DurationMinutes.Value min</span>
                    }
                </div>
                <p style="color: var(--color-text-secondary); font-size: 1.1rem; line-height: 1.6;">
                    @Model.Video.Description
                </p>
            </div>


        </div>

    </div>
</div>

<style>
@@keyframes spin {
    to { transform: rotate(360deg); }
}
</style>
