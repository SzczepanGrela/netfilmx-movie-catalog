@model NetFilmx_Web.ViewModels.HomePageViewModel
@{
    ViewData["Title"] = "Strona główna";
}

@if (Model.FeaturedVideo != null)
{
    var hero = Model.FeaturedVideo;
    var duration = hero.DurationMinutes.HasValue ? $"{hero.DurationMinutes.Value / 60}hr {hero.DurationMinutes.Value % 60}min" : "";
    
    <div class="nfx-hero" style="background-image: url('@(hero.BackdropUrl ?? hero.ThumbnailUrl)');">
        <div class="nfx-hero-overlay"></div>
        <div class="nfx-hero-content">
            <h1 class="nfx-hero-title">@hero.Title</h1>
            
            <div class="nfx-hero-meta">
                @if (!string.IsNullOrEmpty(hero.AgeRating))
                {
                    <span class="nfx-badge">@hero.AgeRating</span>
                }
                @if (!string.IsNullOrEmpty(hero.QualityBadge))
                {
                    <span class="nfx-badge">@hero.QualityBadge</span>
                }
                @if (hero.ReleaseYear.HasValue)
                {
                    <span>@hero.ReleaseYear.Value</span>
                }
                @if (!string.IsNullOrEmpty(duration))
                {
                    <span>@duration</span>
                }
            </div>

            <p class="nfx-hero-desc">@hero.Description</p>
            
            <div class="nfx-hero-cast">
                @if (!string.IsNullOrEmpty(hero.Director))
                {
                    <div><span data-i18n="t_rezyser">Reżyser:</span> @hero.Director</div>
                }
                @if (!string.IsNullOrEmpty(hero.Cast))
                {
                    <div><span data-i18n="t_obsada">Obsada:</span> @hero.Cast</div>
                }
            </div>

            <div class="nfx-hero-buttons">
                <a asp-controller="Home" asp-action="Watch" asp-route-id="@hero.Id" class="nfx-btn nfx-btn-primary" data-i18n="t_odtworz">▶ Odtwórz</a>
                <a asp-controller="Home" asp-action="Details" asp-route-id="@hero.Id" class="nfx-btn nfx-btn-secondary" data-i18n="t_wiecej_informacji">ℹ Więcej informacji</a>
            </div>
        </div>
    </div>
}

<div class="nfx-section">
    <h2 class="nfx-section-title" data-i18n="t_wszystkie_filmy">Wszystkie filmy</h2>
    <div class="nfx-carousel">
        @if (Model.AllVideos != null && Model.AllVideos.Any())
        {
            foreach (var video in Model.AllVideos)
            {
                var imgUrl = video.ThumbnailUrl ?? "https://netfilmx-assets.grela.dev/placeholder.jpg";
                <a asp-controller="Home" asp-action="Watch" asp-route-id="@video.Id" class="nfx-card">
                    <img src="@imgUrl" alt="@video.Title" class="nfx-card-img" loading="lazy" />
                    <div class="nfx-card-overlay">
                        <span class="nfx-card-title">@video.Title</span>
                    </div>
                </a>
            }
        }
    </div>
</div>

<div class="nfx-section" style="margin-top: 2rem;">
    <h2 class="nfx-section-title" data-i18n="t_serie">Serie</h2>
    <div class="nfx-carousel">
        @if (Model.AllSeries != null && Model.AllSeries.Any())
        {
            foreach (var series in Model.AllSeries)
            {
                var imgUrl = series.PosterUrl ?? "https://netfilmx-assets.grela.dev/placeholder.jpg";
                <a asp-controller="Home" asp-action="SeriesDetails" asp-route-id="@series.Id" class="nfx-card">
                    <img src="@imgUrl" alt="@series.Name" class="nfx-card-img" loading="lazy" />
                    <div class="nfx-card-overlay">
                        <span class="nfx-card-title">@series.Name</span>
                    </div>
                </a>
            }
        }
    </div>
</div>
@if (Model.FeaturedVideo == null && (Model.AllVideos == null || !Model.AllVideos.Any()))
{
    <div class="nfx-hero" style="background: linear-gradient(135deg, var(--color-surface) 0%, var(--color-base) 100%); display: flex; align-items: center; justify-content: center; height: 100vh;">
        <div style="text-align: center; z-index: 10;">
            <h1 class="nfx-hero-title" data-i18n="t_katalog_jest_pusty">Katalog jest pusty</h1>
            <p class="nfx-hero-desc" style="max-width: 600px; margin: 0 auto 2rem;" data-i18n="t_katalog_jest_pusty_opis">Wygląda na to, że baza danych nie zawiera jeszcze żadnych filmów. Zaloguj się do panelu administratora, aby dodać pierwsze pozycje.</p>
        </div>
    </div>
}
