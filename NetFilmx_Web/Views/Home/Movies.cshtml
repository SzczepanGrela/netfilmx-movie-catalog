@model NetFilmx_Web.ViewModels.MoviesPageViewModel
@{
    ViewData["Title"] = "Movies";
}

<div style="padding-top: 100px; min-height: 100vh; padding-bottom: 4rem;">
    <div style="max-width: 1600px; margin: 0 auto; padding: 0 4%;">
        
        <!-- Header Info -->
        <div style="margin-bottom: 1.5rem;">
            <h1 style="font-size: 2.5rem; font-weight: 700; margin-bottom: 0.5rem;" data-i18n="t_katalog_filmow">Movie Catalog</h1>
            <p style="color: var(--color-text-secondary); font-size: 1rem;" data-i18n="t_katalog_filmow_podpis">Discover all available movies and productions in HD and 4K quality.</p>
        </div>

        <!-- Centered / Full Width Search Hub -->
        <div style="margin-bottom: 2.5rem; display: flex; justify-content: flex-start;">
            <form method="get" asp-action="Movies" class="nfx-search-hub" style="width: 100%; max-width: 900px;">
                <div class="nfx-search-input-wrap">
                    <i class="fas fa-search nfx-search-icon"></i>
                    <input type="text" name="search" value="@Model.SearchTerm" class="nfx-search-input"
                           placeholder="Search movies, directors, cast..." data-i18n-placeholder="t_szukaj_placeholder" />
                </div>

                @if (Model.Categories != null && Model.Categories.Any())
                {
                    <div class="nfx-search-divider"></div>
                    <select name="categoryId" class="nfx-search-select" onchange="this.form.submit()">
                        <option value="">All Categories</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.Id" selected="@(Model.SelectedCategoryId == cat.Id ? "selected" : null)">@cat.Name</option>
                        }
                    </select>
                }

                <button type="submit" class="nfx-search-submit">
                    <i class="fas fa-search"></i>
                    <span data-i18n="t_szukaj">Search</span>
                </button>

                @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.SelectedCategoryId.HasValue || Model.SelectedTagId.HasValue)
                {
                    <a asp-action="Movies" class="nfx-search-clear" title="Clear filters">
                        <i class="fas fa-times"></i>
                        <span data-i18n="t_wyczysc_filtry">Clear</span>
                    </a>
                }
            </form>
        </div>

        @if (!string.IsNullOrEmpty(Model.DidYouMeanSuggestion))
        {
            <div style="margin-top: -1.5rem; margin-bottom: 2rem; padding: 0.75rem 1.25rem; background: rgba(123, 44, 191, 0.15); border: 1px solid rgba(123, 44, 191, 0.4); border-radius: 12px; display: inline-flex; align-items: center; gap: 0.75rem; color: #fff; font-size: 0.95rem;">
                <i class="fas fa-lightbulb" style="color: #ffb703; font-size: 1.1rem;"></i>
                <span>
                    <span data-i18n="t_czy_chodzilo_o">Did you mean:</span>
                    <a asp-action="Movies" asp-route-search="@Model.DidYouMeanSuggestion" style="color: #4cc9f0; font-weight: 600; text-decoration: underline; margin-left: 0.25rem;">
                        @Model.DidYouMeanSuggestion
                    </a>?
                </span>
            </div>
        }

        <!-- Video Grid -->
        @if (Model.Videos != null && Model.Videos.Any())
        {
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1.5rem;">
                @foreach (var video in Model.Videos)
                {
                    var imgUrl = video.ThumbnailUrl ?? "https://netfilmx-assets.grela.dev/posters/sintel_poster.jpg";
                    <div class="nfx-card" style="aspect-ratio: 2/3; width: 100%; max-width: none;">
                        <a asp-controller="Home" asp-action="Details" asp-route-id="@video.Id" style="display: block; width: 100%; height: 100%;">
                            <img src="@imgUrl" alt="@video.Title" class="nfx-card-img" loading="lazy" />
                        </a>
                        <div class="nfx-card-overlay" style="opacity: 1; background: linear-gradient(to top, rgba(4, 8, 20, 0.95) 0%, rgba(4, 8, 20, 0.5) 60%, transparent 100%);">
                            <div style="width: 100%; position: relative; z-index: 20;">
                                @if (!string.IsNullOrEmpty(video.QualityBadge))
                                {
                                    <span class="nfx-badge" style="font-size: 0.7rem; padding: 0.2rem 0.5rem; margin-bottom: 0.4rem; display: inline-block;">@video.QualityBadge</span>
                                }
                                <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.3rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@video.Title</h3>
                                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; color: var(--color-text-secondary); margin-bottom: 0.8rem;">
                                    <span>@(video.ReleaseYear?.ToString() ?? "2026")</span>
                                    <span>@(video.DurationMinutes.HasValue ? $"{video.DurationMinutes.Value} min" : "")</span>
                                </div>
                                <div style="display: flex; gap: 0.5rem; position: relative; z-index: 30;">
                                    <a asp-controller="Home" asp-action="Watch" asp-route-id="@video.Id" class="nfx-btn nfx-btn-primary" style="flex: 1; padding: 0.45rem; font-size: 0.85rem; position: relative; z-index: 40;" data-i18n="t_odtworz">▶ Play</a>
                                    <a asp-controller="Home" asp-action="Details" asp-route-id="@video.Id" class="nfx-btn nfx-btn-secondary" style="padding: 0.45rem 0.8rem; font-size: 0.85rem; position: relative; z-index: 40;" title="Details">ℹ</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div style="display: flex; justify-content: center; gap: 0.5rem; margin-top: 3rem;">
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <a asp-action="Movies" asp-route-page="@p" asp-route-search="@Model.SearchTerm" asp-route-categoryId="@Model.SelectedCategoryId"
                           class="nfx-btn @(p == Model.CurrentPage ? "nfx-btn-primary" : "nfx-btn-secondary")" style="padding: 0.5rem 1rem; font-size: 0.9rem;">
                            @p
                        </a>
                    }
                </div>
            }
        }
        else
        {
            <div style="text-align: center; padding: 5rem 1rem; background: rgba(10, 17, 40, 0.4); border-radius: var(--border-radius); border: 1px solid rgba(123, 44, 191, 0.2);">
                <i class="fas fa-film" style="font-size: 3rem; color: var(--color-text-secondary); margin-bottom: 1rem; display: block;"></i>
                <h3 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.5rem;" data-i18n="t_brak_filmow">No movies found</h3>
                <p style="color: var(--color-text-secondary); max-width: 500px; margin: 0 auto 1.5rem;" data-i18n="t_brak_filmow_opis">No movies match the selected search criteria.</p>
                <a asp-action="Movies" class="nfx-btn nfx-btn-secondary" data-i18n="t_zresetuj_filtry">Reset filters</a>
            </div>
        }

    </div>
</div>
