@model NetFilmx_Web.ViewModels.SeriesDetailsViewModel
@{
    ViewData["Title"] = Model.Series.Name;
}

<div style="padding-top: 80px; min-height: 100vh; position: relative; padding-bottom: 4rem;">
    
    <!-- Ambient Backdrop -->
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 60vh; background-image: url('@(Model.Series.BackdropUrl ?? Model.Series.PosterUrl ?? "https://netfilmx-assets.grela.dev/backdrops/big-buck-bunny_backdrop.png")'); background-size: cover; background-position: center; filter: blur(40px) brightness(0.25); z-index: 0; pointer-events: none;"></div>

    <div style="position: relative; z-index: 10; max-width: 1400px; margin: 0 auto; padding: 2rem 4%;">
        
        <!-- Header Info -->
        <div style="display: flex; flex-wrap: wrap; gap: 3rem; margin-bottom: 3.5rem; align-items: flex-start;">
            <div style="flex: 0 0 280px; width: 280px; max-width: 100%;">
                <div style="border-radius: var(--border-radius); overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.6); border: 1px solid rgba(123, 44, 191, 0.3);">
                    <img src="@(Model.Series.PosterUrl ?? Model.Series.BackdropUrl ?? "https://netfilmx-assets.grela.dev/posters/sintel_poster.jpg")" alt="@Model.Series.Name" style="width: 100%; aspect-ratio: 2/3; object-fit: cover; display: block;" />
                </div>
            </div>

            <div style="flex: 1; min-width: 320px;">
                <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; align-items: center;">
                    @if (!string.IsNullOrEmpty(Model.Series.QualityBadge))
                    {
                        <span class="nfx-badge">@Model.Series.QualityBadge</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Series.AgeRating))
                    {
                        <span class="nfx-badge" style="background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.3); color: #fff;">@Model.Series.AgeRating</span>
                    }
                    @if (Model.Series.ReleaseYear.HasValue)
                    {
                        <span style="color: var(--color-text-secondary); font-weight: 500;">@Model.Series.ReleaseYear.Value</span>
                    }
                    <span style="color: var(--color-text-secondary); font-weight: 500;">• @(Model.Episodes?.Count ?? 0) Episodes</span>
                </div>

                <h1 style="font-size: 3rem; font-weight: 700; margin-bottom: 1.5rem; line-height: 1.2;">@Model.Series.Name</h1>

                <p style="color: #e0e0e0; font-size: 1.15rem; line-height: 1.7; margin-bottom: 2rem;">
                    @Model.Series.Description
                </p>

                @if (!string.IsNullOrEmpty(Model.Series.Director) || !string.IsNullOrEmpty(Model.Series.Cast))
                {
                    <div style="background: rgba(10, 17, 40, 0.5); backdrop-filter: blur(16px); border: 1px solid rgba(123, 44, 191, 0.2); border-radius: var(--border-radius); padding: 1.2rem; margin-bottom: 2rem; display: flex; flex-wrap: wrap; gap: 2rem;">
                        @if (!string.IsNullOrEmpty(Model.Series.Director))
                        {
                            <div>
                                <span style="color: var(--color-text-secondary); font-size: 0.85rem; display: block;" data-i18n="t_rezyser">Director:</span>
                                <strong style="color: white;">@Model.Series.Director</strong>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Series.Cast))
                        {
                            <div>
                                <span style="color: var(--color-text-secondary); font-size: 0.85rem; display: block;" data-i18n="t_obsada">Cast:</span>
                                <strong style="color: white;">@Model.Series.Cast</strong>
                            </div>
                        }
                    </div>
                }

                <div>
                    <a asp-action="Series" class="nfx-btn nfx-btn-secondary" data-i18n="t_wroc_do_serii">
                        ← Back to Series
                    </a>
                </div>
            </div>
        </div>

        <!-- Episodes Section -->
        <div>
            <h2 style="font-size: 1.8rem; font-weight: 700; margin-bottom: 1.5rem;" data-i18n="t_odcinki_serii">Series Episodes</h2>

            @if (Model.Episodes != null && Model.Episodes.Any())
            {
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    @for (int i = 0; i < Model.Episodes.Count; i++)
                    {
                        var ep = Model.Episodes[i];
                        var duration = ep.DurationMinutes.HasValue ? $"{ep.DurationMinutes.Value} min" : "";
                        <div style="display: flex; flex-wrap: wrap; gap: 1.5rem; background: rgba(10, 17, 40, 0.6); backdrop-filter: blur(16px); border: 1px solid rgba(123, 44, 191, 0.2); border-radius: var(--border-radius); padding: 1.2rem; align-items: center; transition: transform 0.2s ease, border-color 0.2s ease;">
                            
                            <!-- Index Badge -->
                            <div style="font-size: 1.8rem; font-weight: 700; color: var(--color-text-secondary); min-width: 40px; text-align: center;">
                                @(i + 1)
                            </div>

                            <!-- Thumbnail -->
                            <div style="flex: 0 0 180px; width: 180px; aspect-ratio: 16/9; border-radius: 8px; overflow: hidden; position: relative;">
                                <img src="@(ep.ThumbnailUrl ?? "https://netfilmx-assets.grela.dev/posters/sintel_poster.jpg")" alt="@ep.Title" style="width: 100%; height: 100%; object-fit: cover;" />
                            </div>

                            <!-- Episode Info -->
                            <div style="flex: 1; min-width: 250px;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                                    <h3 style="font-size: 1.2rem; font-weight: 600; margin: 0;">@ep.Title</h3>
                                    @if (!string.IsNullOrEmpty(duration))
                                    {
                                        <span style="color: var(--color-text-secondary); font-size: 0.9rem;">@duration</span>
                                    }
                                </div>
                                <p style="color: var(--color-text-secondary); font-size: 0.95rem; margin: 0; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @ep.Description
                                </p>
                            </div>

                            <!-- Play Button -->
                            <div>
                                <a asp-controller="Home" asp-action="Watch" asp-route-id="@ep.Id" class="nfx-btn nfx-btn-primary" style="padding: 0.6rem 1.4rem; font-size: 0.95rem;" data-i18n="t_odtworz">
                                    ▶ Play
                                </a>
                            </div>

                        </div>
                    }
                </div>
            }
            else
            {
                <div style="text-align: center; padding: 4rem 1rem; background: rgba(10, 17, 40, 0.4); border-radius: var(--border-radius); border: 1px solid rgba(123, 44, 191, 0.2);">
                    <p style="color: var(--color-text-secondary); margin: 0;" data-i18n="t_brak_odcinkow">No episodes added to this series yet.</p>
                </div>
            }
        </div>

    </div>
</div>
