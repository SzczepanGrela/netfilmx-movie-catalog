@model NetFilmx_Web.Services.FilmCredit
@{ var key = "t_credit_" + Model.Slug; }
<section class="media-credit" id="credit-@Model.Slug" aria-labelledby="credit-title-@Model.Slug">
    <h2 id="credit-title-@Model.Slug">@Model.Title</h2>
    <div class="media-credit-section">
        <h3 data-i18n="t_credit_film">Film</h3>
        <div class="media-credit-body">
            <p>@Model.Creator</p>
            <p data-i18n="@(key + "_production")">@Model.Production</p>
            <p class="media-credit-links">
                <a href="@Model.SourceUrl" rel="noreferrer" data-i18n="t_credit_source">Source and credits</a>
                @if (Model.LicenseUrl is not null) { <a href="@Model.LicenseUrl" rel="noreferrer">@Model.License</a> }
            </p>
            @if (Model.Pending is not null) { <p class="media-credit-pending">@Model.Pending</p> }
        </div>
    </div>
    <div class="media-credit-section">
        <h3 data-i18n="t_credit_artwork">Artwork</h3>
        <ul class="media-credit-body media-credit-artwork">
            @foreach (var art in Model.Artwork)
            {
                var artKey = key + "_" + art.Role.ToLowerInvariant();
                <li>
                    <h4 data-i18n="@("t_credit_" + art.Role.ToLowerInvariant())">@art.Role</h4>
                    <p data-i18n="@(artKey + "_creator")">@art.Creator</p>
                    <p class="media-credit-links">
                        <a href="@art.SourceUrl" rel="noreferrer" data-i18n="t_credit_source">Source and credits</a>
                        @if (art.LicenseUrl is not null) { <a href="@art.LicenseUrl" rel="noreferrer">@art.License</a> }
                    </p>
                    <p class="media-credit-note" data-i18n="@(artKey + "_changes")">@art.Changes</p>
                </li>
            }
        </ul>
    </div>
    <div class="media-credit-section">
        <h3 data-i18n="t_credit_preparation">Preparation</h3>
        <div class="media-credit-body media-credit-note">
            <p data-i18n="@(key + "_changes")">@Model.Changes</p>
            <p data-i18n="t_credit_full_roll">The complete film credits are retained in the video.</p>
        </div>
    </div>
</section>
