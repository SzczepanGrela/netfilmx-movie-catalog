<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — NetFilmx</title>
    <meta name="description" content="NetFilmx — Twoja platforma VOD z filmami Blender Foundation" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="nfx-navbar" id="main-nav">
        <div class="nfx-navbar-inner">
            <a class="nfx-logo" href="/">NetFilm<span class="nfx-logo-accent">x</span></a>
            <div class="nfx-nav-links">
                <a href="/" class="nfx-nav-link">Strona główna</a>
                <a href="#" class="nfx-nav-link">Filmy</a>
                <a href="#" class="nfx-nav-link">Serie</a>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="nfx-footer">
        <p>&copy; @DateTime.Now.Year NetFilmx. Wszystkie prawa zastrzeżone.</p>
    </footer>

    <script>
        // Navbar scroll effect — becomes opaque on scroll
        const nav = document.getElementById('main-nav');
        window.addEventListener('scroll', () => {
            nav.classList.toggle('nfx-navbar-scrolled', window.scrollY > 50);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
