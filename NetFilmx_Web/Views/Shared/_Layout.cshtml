<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — NetFilmx</title>
    <meta name="description" content="NetFilmx — Twoja platforma VOD z filmami Blender Foundation" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="nfx-navbar" id="main-nav">
        <div class="nfx-navbar-inner">
            <a class="nfx-logo" href="/">NetFilm<span class="nfx-logo-accent">x</span></a>
            
            <!-- Hamburger Icon -->
            <button class="nfx-menu-toggle" id="menu-toggle" aria-label="Toggle navigation">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <div class="nfx-nav-menu" id="nav-menu">
                <div class="nfx-nav-links">
                    <a asp-controller="Home" asp-action="Index" class="nfx-nav-link" data-i18n="t_wroc_na_strone_glowna">Strona główna</a>
                    <a asp-controller="Home" asp-action="Movies" class="nfx-nav-link" data-i18n="t_dodaj_wybrane_filmy">Filmy</a>
                    <a asp-controller="Home" asp-action="Series" class="nfx-nav-link" data-i18n="t_add_series">Serie</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nfx-nav-link" data-i18n="t_panel_admina">Panel Admina</a>
                    }
                </div>

                <div class="nfx-nav-auth">
                    <!-- i18n switcher -->
                    <div class="lang-selector">
                        <button id="lang-pl-btn" class="btn-lang active">PL</button>
                        <button id="lang-en-btn" class="btn-lang">EN</button>
                    </div>

                    <button id="theme-toggle" class="nfx-theme-btn" aria-label="Toggle Theme">
                        <i class="fas fa-moon"></i>
                    </button>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <span class="nfx-user-greeting" data-i18n="t_witaj">Witaj, @User.Identity.Name!</span>
                        <a asp-controller="Auth" asp-action="Logout" class="nfx-btn nfx-btn-secondary" data-i18n="t_wyloguj">Wyloguj</a>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="nfx-nav-link" data-i18n="t_zaloguj_sie">Zaloguj się</a>
                        <a asp-controller="Auth" asp-action="Register" class="nfx-btn nfx-btn-primary" data-i18n="t_zarejestruj_sie">Zarejestruj się</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="nfx-footer">
        <p>&copy; @DateTime.Now.Year NetFilmx. <span data-i18n="t_wszelkie_prawa_zastrzezone">Wszystkie prawa zastrzeżone.</span></p>
    </footer>

    <script src="~/js/i18n.js"></script>

    <script>
        // Navbar scroll effect — becomes opaque on scroll
        const nav = document.getElementById('main-nav');
        window.addEventListener('scroll', () => {
            nav.classList.toggle('nfx-navbar-scrolled', window.scrollY > 50);
        });

        // Mobile menu toggle
        const menuToggle = document.getElementById('menu-toggle');
        const navMenu = document.getElementById('nav-menu');
        menuToggle.addEventListener('click', () => {
            navMenu.classList.toggle('active');
            menuToggle.classList.toggle('active');
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
